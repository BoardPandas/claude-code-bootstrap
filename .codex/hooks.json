{
  "description": "GENERATED by scripts/sync-codex.mjs from .claude/settings.json. Edit that file, then run npm run sync:codex. Hooks run the same .claude/scripts/ as Claude Code; there is deliberately no second copy.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/scripts/session-start-kb-check.sh\"",
            "commandWindows": "bash .claude/scripts/session-start-kb-check.sh",
            "statusMessage": "Surfacing LL-G / BP knowledge-base reminder..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/scripts/check-commit-herestring.sh\"",
            "commandWindows": "bash .claude/scripts/check-commit-herestring.sh",
            "statusMessage": "Checking commit message syntax..."
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/scripts/pre-commit-changelog-reminder.sh\"",
            "commandWindows": "bash .claude/scripts/pre-commit-changelog-reminder.sh",
            "statusMessage": "Checking changelog update..."
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/scripts/check-changelog-staged.sh\"",
            "commandWindows": "bash .claude/scripts/check-changelog-staged.sh",
            "statusMessage": "Verifying changelog is staged..."
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/scripts/require-release-authorization.sh\"",
            "commandWindows": "bash .claude/scripts/require-release-authorization.sh",
            "statusMessage": "Checking release authorization..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/scripts/post-commit-kb-contribute.sh\"",
            "commandWindows": "bash .claude/scripts/post-commit-kb-contribute.sh",
            "statusMessage": "Checking for knowledge base contributions..."
          }
        ]
      }
    ]
  }
}
